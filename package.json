{
  "name": "chromeos-vm-manager",
  "version": "1.0.0",
  "description": "Chrome OS Virtual Machine Management System for Windows 10 VMs",
  "main": "backend/server.js",
  "type": "module",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node backend/server.js --dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "webpack --config webpack.config.js",
    "build:backend": "tsc --project tsconfig.backend.json",
    "build:standalone": "npm run build && npm run bundle:win && npm run bundle:linux && npm run bundle:mac",
    "bundle:win": "pkg --targets win-x64 --output dist/chromeos-vm-manager-win.exe .",
    "bundle:linux": "pkg --targets linux-x64 --output dist/chromeos-vm-manager-linux .",
    "bundle:mac": "pkg --targets macos-x64 --output dist/chromeos-vm-manager-mac .",
    "auto-compile": "node scripts/auto-compile.js",
    "test": "jest",
    "chromeos:setup": "node scripts/chromeos-setup.js"
  },
  "keywords": ["chrome-os", "vm", "windows-10", "virtualization"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.14.2",
    "dotenv": "^16.3.1",
    "axios": "^1.6.0",
    "uuid": "^9.0.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "body-parser": "^1.20.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.21",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.1",
    "@babel/core": "^7.23.5",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "babel-loader": "^9.1.3",
    "jest": "^29.7.0",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [
      "public/**",
      "dist/**",
      "config/**",
      ".env"
    ],
    "scripts": [
      "backend/**"
    ],
    "outputPath": "dist"
  }
}
